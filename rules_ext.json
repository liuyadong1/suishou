   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-pose",
   "subs": [
    "full",
    "half",
    "travel",
    "sit",
    "selfie"
   ],
   "when": "pose_on && pose_score >= 0 && pose_score < 75",
   "priority": 4,
   "confidence": "medium",
   "tip": "{pose_hint}",
   "problem": "姿势相似度 {pose_score}%",
   "picto": "pose",
   "draw": {
