{
 "name": "随手大师场景补充规则与技巧",
 "version": "ss-2.1",
 "note": "SS- 开头的是针对 10 类细分场景的补充规则（subs 指细分场景，when 为表达式，draw 为画面标注）；tips 为画面无问题时轮播的技巧。由 tools/build_rules.py 与 knowledge/photo_rules.json 合并成 rules.json。",
 "rules": [
  {
   "id": "SS-level",
   "subs": [
    "vista",
    "city",
    "sunset",
    "night",
    "full",
    "half",
    "travel",
    "sit"
   ],
   "when": "has_tilt && tilt_abs >= 1.5 && tilt_abs < 10 && (!has_hz || ['half','sit'].includes(sub))",
   "priority": 3,
   "confidence": "high",
   "tip": "{tilt > 0 ? '手机右侧抬高一点' : '手机左侧抬高一点'}，摆正再拍",
   "problem": "画面歪了 {tilt_abs}°",
   "picto": "tilt",
   "flip": "tilt < 0",
   "draw": {
    "type": "tilt",
    "theta": "tilt",
    "src": "tilt_src"
   },
   "principle": "地平线或建筑线一歪，整张照片就显得不稳。",
   "note": "主库 COMP-001 在检测到地平线时负责提示；本条补充没有地平线的画面，以及主库未覆盖的半身照、坐姿。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-fore",
   "subs": [
    "vista"
   ],
   "when": "has_hz && low_edge < 0.04 && low_sd < 12",
   "priority": 4,
   "confidence": "medium",
   "tip": "画面下方放点石头、花草做前景",
   "problem": "前景有点空，画面缺少层次",
   "picto": "fore",
   "principle": "前景、中景、远景三层叠在一起，照片才有纵深感。",
   "note": "主库 COMP-024 需要深度信息；本条用画面下部纹理近似判断。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-top",
   "subs": [
    "city"
   ],
   "when": "top_edge > 0.15 && vdens > 0.04",
   "priority": 4,
   "confidence": "medium",
   "tip": "后退几步，把楼顶拍全",
   "problem": "楼顶可能被切掉了",
   "picto": "top",
   "draw": {
    "type": "topband"
   },
   "principle": "建筑顶部往往最有特点，切掉会显得不完整。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-sunexp",
   "subs": [
    "sunset"
   ],
   "when": "hi > 0.04",
   "priority": 2,
   "confidence": "high",
   "tip": "点一下最亮处，降低曝光",
   "problem": "天空过曝，晚霞颜色会丢",
   "picto": "bright",
   "principle": "日落时按亮部测光，天空的颜色才保得住。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-sunhz",
   "subs": [
    "sunset"
   ],
   "when": "has_hz && hz_y < 0.58",
   "priority": 3,
   "confidence": "high",
   "tip": "手机往上仰，天空占三分之二",
   "problem": "日落的天空留得不够",
   "picto": "pitchUp",
   "draw": {
    "type": "hline",
    "y": "hz_y",
    "t": "2/3"
   },
   "principle": "日落的主角是天空和云，给它更多画面。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-sunpos",
   "subs": [
    "sunset"
   ],
   "when": "sun_mean > 220 && abs(sun_x - 0.5) < 0.12 && abs(sun_y - 0.5) < 0.15",
   "priority": 3,
   "confidence": "medium",
   "tip": "把太阳移到三分线交点",
   "problem": "太阳在正中间，画面呆板",
   "picto": "sunpos",
   "draw": {
    "type": "arrow2",
    "x": "sun_x",
    "y": "sun_y",
    "tx": "sun_tx",
    "ty": "sun_ty",
    "label": "太阳放这里"
   },
   "principle": "主体偏离正中，画面更有张力。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-nightmerge",
   "subs": [
    "night"
   ],
   "when": "mean < 45",
   "priority": 2,
   "confidence": "high",
   "tip": "开夜景合成，按快门后别动",
   "problem": "光线很暗，单张噪点多",
   "picto": "moon",
   "suppresses": [
    "EXP-006"
   ],
   "principle": "连拍多张对齐叠加，噪点随帧数增加而减少。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-bright",
   "subs": [
    "vista",
    "city",
    "macro",
    "full",
    "half",
    "travel",
    "sit",
    "selfie"
   ],
   "when": "hi > 0.12",
   "priority": 2,
   "confidence": "high",
   "tip": "点一下最亮处，降低曝光",
   "problem": "亮部过曝，细节会丢",
   "picto": "bright",
   "principle": "过曝的区域是纯白的，后期也救不回来。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-noperson",
   "subs": [
    "full",
    "half",
    "travel",
    "sit",
    "selfie"
   ],
   "when": "!has_person && has_human",
   "priority": 4,
   "confidence": "high",
   "tip": "{sub === 'selfie' ? '把脸放进椭圆框里' : '让人物进入画面，至少露出肩膀'}",
   "problem": "还没找到人物",
   "picto": "noperson",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-pos",
   "subs": [
    "full",
    "travel",
    "sit"
   ],
   "when": "has_person && abs(p_cx - 0.5) > 0.05 && abs(pos_d) > 0.06",
   "priority": 3,
   "confidence": "high",
   "tip": "{pos_d > 0 ? '手机向左平移一点' : '手机向右平移一点'}",
   "problem": "人物不在三分线上",
   "picto": "panLeft",
   "flip": "pos_d < 0",
   "draw": {
    "type": "move",
    "x": "p_cx",
    "y": "p_cy",
    "tx": "pos_t"
   },
   "principle": "人站在三分线上，另一侧留给风景，主次分明。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-headcut",
   "subs": [
    "full",
    "half"
   ],
   "when": "has_person && head_top < 0.02",
   "priority": 3,
   "confidence": "high",
   "tip": "手机往上抬，头顶留点空",
   "problem": "头顶快被切到了",
   "picto": "headCut",
   "draw": {
    "type": "band"
   },
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-headroom-full",
   "subs": [
    "full"
   ],
   "when": "has_person && head_top > 0.15 && !(full && ankle_y > 0.9)",
   "priority": 4,
   "confidence": "medium",
   "tip": "手机往下压一点，或走近一步",
   "problem": "头顶留白太多，人显得矮",
   "picto": "headroom",
   "draw": {
    "type": "headroom",
    "y": "head_top"
   },
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-headroom-half",
   "subs": [
    "half"
   ],
   "when": "has_person && head_top > 0.2",
   "priority": 4,
   "confidence": "medium",
   "tip": "手机往下压一点，或走近一步",
   "problem": "头顶留白太多",
   "picto": "headroom",
   "draw": {
    "type": "headroom",
    "y": "head_top"
   },
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-legs",
   "subs": [
    "full"
   ],
   "when": "has_person && full && ankle_y < 0.88",
   "priority": 4,
   "confidence": "high",
   "tip": "手机放到腰部，脚踩底边更显高",
   "problem": "脚离画面底边太远",
   "picto": "legs",
   "draw": {
    "type": "guideH",
    "y": "0.95",
    "from": "ankle_y",
    "label": "脚踩这条线"
   },
   "principle": "手机放低、脚贴近画面底部，透视会把腿拉长。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-toobig",
   "subs": [
    "travel"
   ],
   "when": "has_person && height_ratio > 0.42",
   "priority": 3,
   "confidence": "high",
   "tip": "后退几步，多留一点风景",
   "problem": "打卡照里人占得太大",
   "picto": "toobig",
   "draw": {
    "type": "sizebox",
    "x": "p_cx"
   },
   "principle": "人占画面 1/4~1/3 高，风景才有存在感。",
   "category": "app",
   "source": "随手大师 · 场景补充规则",
   "detectability": "realtime"
  },
  {
   "id": "SS-neck",
   "subs": [
    "travel"
   ],
   "when": "has_person && has_hz && abs(hz_y - neck_y) < 0.03",
   "priority": 3,
   "confidence": "high",
   "tip": "手机升高或降低，避开脖子",
